{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "agent-relay": {
        "type": "remote",
        "url": "http://host.docker.internal:8787/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:AGENT_RELAY_TOKEN}"
        }
      }
    }
  }
}
