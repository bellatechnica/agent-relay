#!/usr/bin/env bash
# Launch Codex in a Docker Sandbox with native Agent Relay tools.
#
# The sandbox mounts the current workspace read-write and this Agent Relay
# checkout read-only; the relay mount supplies the skill, and the relay MCP
# server is passed as command-line configuration, so no file is written in the
# sandbox. A profile directory is mounted read-only when one is given; without
# it Codex runs on its own defaults.

AGENT_KIND=codex
PROFILE_FILE_NAME=config.toml
# shellcheck source=scripts/sbx-common.sh
. "$(dirname -- "$(readlink -f -- "$0")")/sbx-common.sh"

relay_parse_args "$@"
relay_resolve_workspace
relay_resolve_root
relay_detect_path_mode

sandbox_name=$(relay_sandbox_name)

mounts=("$(relay_host_path "$workspace_dir")")
if [[ -n "$profile_dir" ]]; then
    mounts+=("$(relay_host_path "$profile_dir"):ro")
fi
if [[ "$relay_root" != "$workspace_dir" ]]; then
    mounts+=("$(relay_host_path "$relay_root"):ro")
    sandbox_relay_root=$(relay_sandbox_path "$relay_root")
else
    sandbox_relay_root=$(relay_sandbox_path "$workspace_dir")
fi
# See the note in claude-sbx: one sandbox per agent, profile and workspace
# basename, reused by later launches rather than replaced.
if ! relay_sandbox_exists "$sandbox_name"; then
    sbx create --no-share-skills --name "$sandbox_name" \
        codex "${mounts[@]}"
    sbx policy allow network --sandbox "$sandbox_name" localhost:8787
fi

codex_home=$(relay_sandbox_env "$sandbox_name" CODEX_HOME '$HOME/.codex')
relay_link_skill "$sandbox_name" "$codex_home/skills" \
    "$sandbox_relay_root/skills/agent-relay-message"

# `codex --profile NAME` layers $CODEX_HOME/NAME.config.toml over the base
# config, so a given profile file is seeded into the sandbox once. Later
# launches keep the sandbox-local copy, which Codex also writes project trust
# and other interactive settings into.
profile_args=()
if [[ -n "$profile_file" ]]; then
    sbx exec "$sandbox_name" sh -c '
        set -eu
        codex_home=$1
        profile_source=$2
        profile_name=$3
        profile_target="$codex_home/$profile_name.config.toml"
        mkdir -p "$codex_home"
        if [ -L "$profile_target" ]; then
            profile_seed="$profile_target.seed"
            cp "$profile_source" "$profile_seed"
            mv -fT "$profile_seed" "$profile_target"
        elif [ ! -e "$profile_target" ]; then
            cp "$profile_source" "$profile_target"
        elif [ ! -f "$profile_target" ]; then
            printf "Codex profile target is not a regular file: %s\n" \
                "$profile_target" >&2
            exit 1
        fi
    ' sh "$codex_home" "$(relay_sandbox_path "$profile_file")" "$profile_name" \
        || relay_die "failed to seed the Codex profile in sandbox: $sandbox_name" 1
    profile_args=(--profile "$profile_name")
fi

# Docker's Codex startup command already supplies its approval-bypass flag;
# repeating it makes Codex reject the invocation.
exec sbx run --name "$sandbox_name" codex -- \
    "${profile_args[@]}" \
    --search \
    -c 'mcp_servers.agent_relay.url="http://host.docker.internal:8787/mcp"' \
    -c 'mcp_servers.agent_relay.required=true' \
    -c 'mcp_servers.agent_relay.tool_timeout_sec=86400' \
    "${relay_agent_args[@]}"
