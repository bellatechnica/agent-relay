#!/usr/bin/env bash
# Launch Antigravity CLI in a Docker Sandbox with native Agent Relay tools.
#
# Docker Sandboxes ships no image for this agent, so the sandbox is created from
# the plain `shell` template and the CLI is installed into it once, at create.
# That install reaches the vendor's own download host, so a sandbox for this
# agent needs general egress where a Claude or Codex sandbox does not.
#
# The sandbox mounts the current workspace read-write and this Agent Relay
# checkout read-only; the relay mount supplies the skill. A profile directory is
# mounted read-only when one is given; without it the CLI runs on its own
# defaults.

AGENT_KIND=agy
PROFILE_FILE_NAME=settings.json
# shellcheck source=scripts/sbx-common.sh
. "$(dirname -- "$(readlink -f -- "$0")")/sbx-common.sh"

relay_parse_args "$@"
relay_resolve_workspace
relay_resolve_root
relay_detect_path_mode

sandbox_name=$(relay_sandbox_name)

mounts=("$(relay_host_path "$workspace_dir")")
if [[ -n "$profile_dir" ]]; then
    mounts+=("$(relay_host_path "$profile_dir"):ro")
fi
if [[ "$relay_root" != "$workspace_dir" ]]; then
    mounts+=("$(relay_host_path "$relay_root"):ro")
    sandbox_relay_root=$(relay_sandbox_path "$relay_root")
else
    sandbox_relay_root=$(relay_sandbox_path "$workspace_dir")
fi

# Read on the host, written into the sandbox below. The file is the single
# source for this server's settings; only the delivery differs from the host
# guide, which points the same entry at loopback instead.
mcp_config=$(cat "$relay_root/examples/agy-mcp.json") \
    || relay_die "cannot read the Agent Relay MCP configuration: $relay_root/examples/agy-mcp.json"

# Sandbox identity is the agent, the profile name when one was given, and the
# workspace basename, so one profile keeps one sandbox per workspace. See the
# note in claude-sbx: a second launch for the same name joins that sandbox
# rather than replacing it, and every process in it shares one VM and mounts.
sandbox_created=
if ! relay_sandbox_exists "$sandbox_name"; then
    sbx create --no-share-skills --name "$sandbox_name" \
        shell "${mounts[@]}"
    sbx policy allow network --sandbox "$sandbox_name" localhost:8787
    sandbox_created=1
fi

sandbox_home=$(relay_sandbox_env "$sandbox_name" HOME /home/agent)
sandbox_skills="$sandbox_home/.gemini/config/skills"

if [[ -n "$sandbox_created" ]]; then
    # The installer verifies a SHA-512 from the vendor's signed manifest and
    # writes one binary under $HOME/.local/bin, which its own shell-profile edit
    # puts on the PATH of the login shell this launcher starts below.
    sbx exec "$sandbox_name" sh -c \
        'curl -fsSL https://antigravity.google/cli/install.sh | bash' \
        || relay_die "failed to install the Antigravity CLI in sandbox: $sandbox_name" 1
    relay_link_skill "$sandbox_name" "$sandbox_skills" \
        "$sandbox_relay_root/skills/agent-relay-message"
else
    relay_verify_skill "$sandbox_name" "$sandbox_skills"
fi

# This CLI reads its MCP servers and its settings from files under $HOME; it has
# no flag for either. Both are therefore written into the sandbox rather than
# passed on the command line. The MCP file is rewritten on every launch because
# it is wholly owned by this launcher. The profile is seeded only when absent,
# because the CLI writes a user's own choices back into that same file.
sbx exec "$sandbox_name" sh -c '
    set -eu
    home=$1
    mcp_config=$2
    profile_source=$3
    mkdir -p "$home/.gemini/config" "$home/.gemini/antigravity-cli"
    printf "%s\n" "$mcp_config" > "$home/.gemini/config/mcp_config.json"
    settings="$home/.gemini/antigravity-cli/settings.json"
    if [ -n "$profile_source" ] && [ ! -e "$settings" ]; then
        if [ ! -r "$profile_source" ]; then
            echo "profile not readable inside this sandbox: $profile_source" >&2
            echo "This sandbox does not mount the profile directory this" >&2
            echo "launcher resolves to. Use the launcher the sandbox was" >&2
            echo "created with, or recreate the sandbox." >&2
            exit 1
        fi
        cp "$profile_source" "$settings"
    fi
' sh "$sandbox_home" "$mcp_config" \
    "$([[ -n "$profile_file" ]] && relay_sandbox_path "$profile_file")" \
    || relay_die "failed to write the Relay configuration into sandbox: $sandbox_name" 1

# The `shell` template starts a login shell, so the CLI is reached through it
# rather than as the sandbox's own agent. The login shell is also what puts the
# installer's PATH edit into effect.
#
# Approvals are turned off, because reaching the CLI this way skips the agent
# entrypoint every other sandboxed agent gets, and Docker Sandboxes turns them
# off in all of those: claude runs with `--dangerously-skip-permissions`, codex
# with `--dangerously-bypass-approvals-and-sandbox`, copilot, cursor and gemini
# with `--yolo`, kiro with `--trust-all-tools`. Prompting here would not make a
# safer sandbox, only an inconsistent one, and an unattended relay listener has
# nobody to answer a prompt. What the approval is traded against is the
# container boundary rather than the dialog — and that boundary does not cover
# the workspace, which is mounted read-write here exactly as for the others.
exec sbx run --name "$sandbox_name" shell -- \
    -lc 'exec agy "$@"' agy --dangerously-skip-permissions \
    "${relay_agent_args[@]}"
